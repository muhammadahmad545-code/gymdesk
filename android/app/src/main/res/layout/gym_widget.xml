<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gym_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/widget_gym" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gymdesk" android:textColor="#FFECEDEF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_checkin_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/gym_widget_button" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:text="Check in" android:textColor="#FF0C0D10" android:textSize="12.5sp" android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/widget_checkins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFECEDEF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check-ins today" android:textColor="#FF9EA4AE" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/widget_due" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFECEDEF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Due this week" android:textColor="#FF9EA4AE" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/widget_overdue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFECEDEF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Overdue" android:textColor="#FF9EA4AE" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
  </LinearLayout>

  <TextView android:id="@+id/widget_revenue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textColor="#FFA3E635" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
